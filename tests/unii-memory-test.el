;;; unii-memory-test.el --- Standalone public boundary regressions -*- lexical-binding: t -*-
(require 'ert)
(require 'unii-memory)
(defmacro unii-memory-test-with-memory (backend policy &rest body)
  (declare (indent 2))
  `(let* ((directory (make-temp-file "unii-memory-test-" t))
          (unii-memory (unii-memory-open directory :backend ,backend :policy ,policy)))
     (unwind-protect (progn ,@body)
       (unii-memory-close unii-memory) (delete-directory directory t))))
(defun unii-memory-test-attempts (unii-memory)
  (plist-get (unii-memory-inspect unii-memory '(:kind attempts :details t)) :entries))

(ert-deftest unii-memory-public-split-receipt-and-exclusive-context ()
  (unii-memory-test-with-memory nil '(:message-bytes 8 :page-bytes 4)
    (let* ((before (unii-memory-append unii-memory '(:kind "user" :text "prior")))
           (receipt (unii-memory-append unii-memory '(:kind "user" :text "🙂🙂🙂")))
           (snapshot (unii-memory-snapshot unii-memory :before (plist-get receipt :first-id))))
      (should (= (plist-get before :first-id) 0))
      (should (equal (plist-get receipt :ids) '(1 2)))
      (should (= (plist-get receipt :end-exclusive) 3))
      (should (eq (plist-get snapshot :state) 'ready))
      (should (= (plist-get snapshot :covered-through) 1))
      (should (string-match-p "prior" (plist-get snapshot :text)))
      (should-not (string-match-p "🙂" (plist-get snapshot :text)))
      (should (equal (plist-get (unii-memory-zoom unii-memory 1 1 :page 1) :text) "🙂"))
      (should (string-match-p "Z$" (unii-memory-date unii-memory 1))))))

(ert-deftest unii-memory-public-pending-has-no-prompt ()
  (unii-memory-test-with-memory nil nil
    (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
    (unii-memory-append unii-memory '(:kind "user" :text "later"))
    (let ((snapshot (unii-memory-snapshot unii-memory)))
      (should (eq (plist-get snapshot :state) 'pending))
      (should (= (plist-get snapshot :covered-through) 0))
      (should-not (plist-get snapshot :text)))
    (should (eq (plist-get (unii-memory-snapshot unii-memory :before 0) :state) 'ready))
    (should (= (plist-get (unii-memory-step unii-memory) :active) 0))))

(ert-deftest unii-memory-public-out-of-order-and-duplicate-completion ()
  (let (pending)
    (unii-memory-test-with-memory (list :start (lambda (request _emit done) (push (cons request done) pending))) nil
      (dotimes (i 2) (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 (+ ?a i)))))
      (unii-memory-step unii-memory)
      (should (= (length pending) 2))
      (let ((last (cdar pending)) (first (cdr (cadr pending))))
        (funcall last '(:text "user: later"))
        (should (= (plist-get (unii-memory-inspect unii-memory 'status) :cursor) 0))
        (funcall first '(:text "user: earlier"))
        (funcall first '(:text "user: overwrite"))
        (funcall last '(:text "user: overwrite"))
        (should (= (plist-get (unii-memory-inspect unii-memory 'status) :cursor) 2))
        (should (= (plist-get (unii-memory-inspect unii-memory 'status) :active) 0))
        (should (string-match-p "earlier" (plist-get (unii-memory-snapshot unii-memory) :text)))
        (should-not (string-match-p "overwrite" (plist-get (unii-memory-snapshot unii-memory) :text)))))))

(ert-deftest unii-memory-public-reads-own-copies ()
  (unii-memory-test-with-memory nil nil
    (unii-memory-append unii-memory '(:kind "user" :text "original"))
    (let ((snapshot (unii-memory-snapshot unii-memory))
          (record (unii-memory-inspect unii-memory '(:kind record :id 0)))
          (nodes (unii-memory-inspect unii-memory 'nodes)))
      (aset (plist-get record :text) 0 ?X)
      (aset (plist-get (car nodes) :text) 0 ?X)
      (aset (plist-get snapshot :text) 0 ?X)
      (setcar (car (plist-get snapshot :view)) 99)
      (should (equal (plist-get (unii-memory-zoom unii-memory 0 1) :text) "original"))
      (should (string-prefix-p "<chat>" (plist-get (unii-memory-snapshot unii-memory) :text))))))

(ert-deftest unii-memory-public-snapshots-survive-compaction-and-reopen ()
  (unii-memory-test-with-memory nil '(:view-high 110 :view-low 65 :compaction-high 85 :compaction-low 50)
    (unii-memory-append unii-memory '(:kind "user" :text "zero"))
    (let ((snapshot (unii-memory-snapshot unii-memory)))
      (dotimes (i 12) (unii-memory-append unii-memory (list :kind "user" :text (format "line-%d" i))))
      (should (equal (plist-get snapshot :view) '((0 0))))
      (should (string-match-p "zero" (plist-get snapshot :text)))
      (should-not (string-match-p "line-" (plist-get snapshot :text)))
      (let ((main (unii-memory-snapshot unii-memory)) (compact (unii-memory-snapshot unii-memory :view 'compaction)))
        (unii-memory-close unii-memory)
        (setq unii-memory (unii-memory-open directory :policy '(:view-high 110 :view-low 65 :compaction-high 85 :compaction-low 50)))
        (should (equal main (unii-memory-snapshot unii-memory)))
        (should (equal compact (unii-memory-snapshot unii-memory :view 'compaction)))))))

(ert-deftest unii-memory-public-valid-shortest-and-bounded-retries ()
  (let* ((calls 0)
         (backend (list :start (lambda (_request _emit done)
                                (cl-incf calls)
                                (funcall done (list :text (make-string (+ 520 calls) ?x)))))))
    (unii-memory-test-with-memory backend nil
      (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
      (unii-memory-step unii-memory)
      (should (= calls 5))
      (should (= (length (plist-get (car (unii-memory-inspect unii-memory 'nodes)) :text)) 521))
      (should (= (plist-get (unii-memory-inspect unii-memory 'usage) :started) 5)))))

(ert-deftest unii-memory-public-validation-rejections-never-become-nodes ()
  (let* ((calls 0)
         (backend (list :start (lambda (_request _emit done)
                                (cl-incf calls) (funcall done (list :text (if (= calls 1) "BAD" "accepted")))))))
    (unii-memory-test-with-memory backend '(:validate-function (lambda (_request text) (when (equal text "BAD") "bad")))
      (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
      (unii-memory-step unii-memory)
      (should (= calls 2))
      (should (equal (plist-get (car (unii-memory-inspect unii-memory 'nodes)) :text) "accepted"))
      (let ((event (cl-find 'summary-validation (plist-get (cadr (unii-memory-test-attempts unii-memory)) :events)
                            :key (lambda (e) (plist-get e :kind)))))
        (should (eq (plist-get event :state) 'rejected))
        (should (equal (plist-get event :response) "BAD"))))))

(ert-deftest unii-memory-public-failure-retry-on-next-append ()
  (let* ((calls 0)
         (backend (list :start (lambda (_request _emit done)
                                (cl-incf calls)
                                (funcall done (if (= calls 1) '(:error (:kind offline :message "offline")) '(:text "user: recovered")))))))
    (unii-memory-test-with-memory backend nil
      (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
      (unii-memory-step unii-memory)
      (should (eq (plist-get (unii-memory-snapshot unii-memory) :state) 'failed))
      (unii-memory-append unii-memory '(:kind "user" :text "next"))
      (unii-memory-step unii-memory)
      (should (= calls 2))
      (should (eq (plist-get (unii-memory-snapshot unii-memory) :state) 'ready)))))

(ert-deftest unii-memory-public-backend-receives-isolated-source-and-stable-job ()
  (let (requests)
    (unii-memory-test-with-memory
        (list :start (lambda (request _emit done)
                       (push request requests)
                       (funcall done (list :text (if (= (plist-get request :attempt) 1) (make-string 520 ?x) "short"))))) nil
      (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
      (unii-memory-step unii-memory)
      (should (= (length requests) 2))
      (should (equal (plist-get (car requests) :job-id) (plist-get (cadr requests) :job-id)))
      (should-not (equal (plist-get (car requests) :attempt-id) (plist-get (cadr requests) :attempt-id)))
      (should (equal (plist-get (car requests) :source) (plist-get (cadr requests) :source)))
      (should (= (length (plist-get (car requests) :prior-turns)) 1))
      (should (string-match-p "Too long:" (plist-get (car requests) :prompt))))))

(ert-deftest unii-memory-public-cumulative-usage-and-late-reports ()
  (let (attempts)
    (unii-memory-test-with-memory
        (list :late-usage t :start
              (lambda (request emit done)
                (push emit attempts)
                (funcall emit (list :kind 'usage :scope 'cumulative :stream-id "thread" :source 'fake
                                    :counters (list :input (* 10 (plist-get request :attempt)) :cached-input (* 8 (plist-get request :attempt)) :output 0)))
                (funcall done (list :text (if (= (plist-get request :attempt) 1) (make-string 520 ?x) "short"))))) nil
      (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
      (unii-memory-step unii-memory)
      (funcall (cadr attempts) '(:kind usage :scope cumulative :stream-id "thread" :counters (:input 10 :cached-input 8)))
      (funcall (car attempts) '(:kind usage :scope cumulative :stream-id "thread" :counters (:input 20 :cached-input 16)))
      (funcall (car attempts) '(:kind usage :scope cumulative :stream-id "thread" :counters (:input 25 :cached-input 20)))
      (let ((usage (unii-memory-inspect unii-memory 'usage)))
        (should (= (plist-get usage :input) 25))
        (should (= (plist-get usage :cachedInput) 20))
        (should (= (plist-get usage :inputObserved) 2))
        (should (= (plist-get usage :outputObserved) 2))
        (should (= (plist-get usage :cacheWriteInputObserved) 0)))
      (funcall (car attempts) '(:kind retired))
      (funcall (car attempts) '(:kind usage :scope cumulative :stream-id "thread" :counters (:input 1000)))
      (should (= (plist-get (unii-memory-inspect unii-memory 'usage) :input) 25)))))

(ert-deftest unii-memory-public-unknown-usage-is-not-reported-zero ()
  (unii-memory-test-with-memory (list :start (lambda (_ _emit done) (funcall done '(:text "short")))) nil
    (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
    (unii-memory-step unii-memory)
    (let ((usage (unii-memory-inspect unii-memory 'usage)))
      (should (= (plist-get usage :started) 1))
      (should (= (plist-get usage :inputObserved) 0))
      (should (= (plist-get usage :cachedInputObserved) 0)))))

(ert-deftest unii-memory-public-events-are-ordered-copied-and-committed ()
  (unii-memory-test-with-memory nil nil
    (let (events unsubscribe)
      (setq unsubscribe
            (unii-memory-subscribe unii-memory (lambda (event)
                                       (push event events)
                                       (when (eq (plist-get event :kind) 'record-appended)
                                         (should (= (plist-get (unii-memory-inspect unii-memory 'status) :count) 1))))))
      (unii-memory-append unii-memory '(:kind "user" :text "first"))
      (should (equal (mapcar (lambda (event) (plist-get event :kind)) (reverse events))
                     '(record-appended node-built view-published)))
      (should (equal (mapcar (lambda (event) (plist-get event :sequence)) (reverse events)) '(1 2 3)))
      (funcall unsubscribe)
      (unii-memory-append unii-memory '(:kind "user" :text "second"))
      (should (= (length events) 3)))))

(ert-deftest unii-memory-public-close-cancels-and-ignores-late-completion ()
  (let (done (cancelled 0) (released 0))
    (unii-memory-test-with-memory
        (list :start (lambda (_ _emit callback) (setq done callback) (lambda () (cl-incf cancelled)))
              :release (lambda (_) (cl-incf released))) nil
      (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
      (unii-memory-step unii-memory)
      (unii-memory-close unii-memory)
      (unii-memory-close unii-memory)
      (funcall done '(:text "must not commit"))
      (should (= cancelled 1)) (should (= released 1))
      (should (= (plist-get (unii-memory-inspect unii-memory 'status) :cursor) 0))
      (should-error (unii-memory-append unii-memory '(:kind "user" :text "closed")))
      (should-error (unii-memory-step unii-memory))
      (setq unii-memory (unii-memory-open directory :backend (list :start (lambda (_ _emit cb) (funcall cb '(:text "recovered"))))))
      (unii-memory-step unii-memory)
      (should (eq (plist-get (unii-memory-snapshot unii-memory) :state) 'ready)))))

(ert-deftest unii-memory-public-close-during-synchronous-start-cancels-returned-work ()
  (let (owner (cancelled 0))
    (unii-memory-test-with-memory
        (list :start (lambda (_ _emit _done) (unii-memory-close owner) (lambda () (cl-incf cancelled)))) nil
      (setq owner unii-memory)
      (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
      (unii-memory-step unii-memory)
      (should (= cancelled 1)))))

(ert-deftest unii-memory-public-malformed-backend-and-validator-errors-fail-closed ()
  (dolist (backend (list (list :start (lambda (_ _emit done) (funcall done '(:error "bad"))))
                        (list :start (lambda (_ _emit done) (funcall done '(:text "short"))))))
    (unii-memory-test-with-memory backend '(:validate-function (lambda (_ _) (error "broken policy")))
      (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
      (unii-memory-step unii-memory)
      (should (= (plist-get (unii-memory-inspect unii-memory 'status) :active) 0))
      (should (eq (plist-get (unii-memory-snapshot unii-memory) :state) 'failed)))))

(ert-deftest unii-memory-public-concurrency-and-admission-bound ()
  (let (callbacks)
    (unii-memory-test-with-memory (list :start (lambda (_ _emit done) (push done callbacks))) '(:concurrency 3)
      (dotimes (_ 20) (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a))))
      (unii-memory-step unii-memory)
      (should (= (length callbacks) 3))
      (should (= (plist-get (unii-memory-inspect unii-memory 'status) :active) 3))
      (should (= (plist-get (unii-memory-inspect unii-memory 'status) :queued) 5))
      (should (= (plist-get (unii-memory-inspect unii-memory 'status) :waiting) 12))
      (unii-memory-step unii-memory)
      (should (= (length callbacks) 3)))))

(ert-deftest unii-memory-public-exact-provider-payload-is-not-inferred ()
  (let (emit done)
    (unii-memory-test-with-memory (list :start (lambda (_ e d) (setq emit e done d))) nil
      (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
      (unii-memory-step unii-memory)
      (let* ((id (plist-get (car (unii-memory-test-attempts unii-memory)) :id))
             (payload (vector (list :sent "actual"))))
        (should-not (plist-get (unii-memory-inspect unii-memory (list :kind 'attempt-detail :id id)) :payload))
        (funcall emit (list :kind 'submission :state 'prepared :payload payload))
        (aset (plist-get (aref payload 0) :sent) 0 ?X)
        (funcall done '(:text "short"))
        (should (equal (plist-get (unii-memory-inspect unii-memory (list :kind 'attempt-detail :id id)) :payload)
                       [(:sent "actual")]))))))

(ert-deftest unii-memory-public-retention-eviction-keeps-ledger ()
  (let ((unii-memory-context-terminal-limit 1))
    (unii-memory-test-with-memory (list :start (lambda (_ emit done)
                                          (funcall emit '(:kind usage :scope attempt :counters (:input 10 :cached-input 0)))
                                          (funcall done '(:text "short")))) nil
      (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
      (unii-memory-step unii-memory)
      (let ((id (plist-get (car (unii-memory-test-attempts unii-memory)) :id)))
        (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?b)))
        (unii-memory-step unii-memory)
        (should-not (plist-get (unii-memory-inspect unii-memory (list :kind 'attempt-detail :id id)) :available))
        (should (= (plist-get (unii-memory-inspect unii-memory 'usage) :input) 20))))))

(ert-deftest unii-memory-public-host-calls-share-retention-with-compactions ()
  (let ((unii-memory-context-terminal-limit 1))
    (unii-memory-test-with-memory (list :start (lambda (_ _emit done) (funcall done '(:text "short")))) nil
      (let ((id (unii-memory-observe unii-memory '(:kind prepared :payload "turn" :provenance (:kind turn)))))
        (unii-memory-observe unii-memory (list :kind 'finished :id id :outcome 'completed))
        (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
        (unii-memory-step unii-memory)
        (should-not (plist-get (unii-memory-inspect unii-memory (list :kind 'attempt-detail :id id)) :available))
        (should (= (plist-get (unii-memory-inspect unii-memory 'attempts) :total) 1))))))

(provide 'unii-memory-test)

(ert-deftest unii-memory-public-exhaustion-retains-validation-reason ()
  (unii-memory-test-with-memory
      (list :start (lambda (_ _emit done) (funcall done '(:text "wrong"))))
      '(:validate-function (lambda (_ _) "source boundary"))
    (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
    (unii-memory-step unii-memory)
    (should (eq (plist-get (unii-memory-snapshot unii-memory) :state) 'failed))
    (let ((events (plist-get (car (unii-memory-test-attempts unii-memory)) :events)))
      (should (equal (plist-get (cl-find 'summary-validation events :key (lambda (e) (plist-get e :kind))) :reason) "source boundary"))
      (should (= (length (unii-memory-test-attempts unii-memory)) 5)))))

(ert-deftest unii-memory-public-attempt-result-retains-backend-error ()
  (unii-memory-test-with-memory
      (list :start (lambda (_ _emit done) (funcall done '(:error (:kind offline :message "auth failed"))))) nil
    (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
    (unii-memory-step unii-memory)
    (should (equal (plist-get (car (unii-memory-test-attempts unii-memory)) :result)
                   '(:error (:kind offline :message "auth failed"))))))

(ert-deftest unii-memory-public-prepared-payload-is-immutable ()
  (let (emit)
    (unii-memory-test-with-memory (list :start (lambda (_ e _done) (setq emit e))) nil
      (unii-memory-append unii-memory (list :kind "user" :text (make-string 600 ?a)))
      (unii-memory-step unii-memory)
      (funcall emit '(:kind submission :state prepared :payload "original" :provenance (:source "forged")))
      (should-error (funcall emit '(:kind submission :state prepared :payload "replacement")))
      (let ((detail (car (unii-memory-test-attempts unii-memory))))
        (should (equal (plist-get detail :payload) "original"))
        (should (string-prefix-p "user:" (plist-get (plist-get detail :provenance) :source)))
        (should-not (plist-member (car (plist-get detail :events)) :payload))))))
